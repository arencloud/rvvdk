+            "2026-04-31T00:00:00Z",
+            "2026-10-01T24:00:00Z",
+            "2026-10-01T00:00:00.Z",
+            "2026-10-01T00:00:00.1234567890Z",
+            "2026-10-01T00:00:00+00:00",
+            "2026-10-01T00:00:00.PRIVATEZ",
