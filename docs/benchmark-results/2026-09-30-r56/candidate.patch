+    assert!(c.revalidate().is_err());
+    struct Changing<'a>(&'a Graph);
+    impl ParentResolver for Changing<'_> {
+        fn resolve_parent(
+            &self,
+            c: EndpointIdentity,
+            h: &str,
+        ) -> Result<Option<SparseChainSource>, BackingError> {
