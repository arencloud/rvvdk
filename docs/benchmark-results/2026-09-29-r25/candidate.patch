+    });
+}
+
+#[test]
+fn invalid_or_exhausted_ring_setup_does_not_fallback() {
+    isolated("invalid_or_exhausted_ring_setup_does_not_fallback", || {
+        for errno in [libc::EINVAL, libc::ENOMEM, libc::EMFILE] {
