+//! Experimental retained-payload backend; identity and journal hashes stay unchanged.
+pub(crate) struct Sha256(ring::digest::Context);
+impl Sha256 {
+    pub(crate) fn new() -> Self {
+        Self(ring::digest::Context::new(&ring::digest::SHA256))
+    }
+    pub(crate) fn update(&mut self, bytes: &[u8]) {
+        self.0.update(bytes);
+    }
+    pub(crate) fn finalize(self) -> [u8; 32] {
+        self.0.finish().as_ref().try_into().expect("SHA-256 length")
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use sha2::Digest;
+    #[test]
+    fn exact_streaming_digest_equivalence() {
+        for size in [0, 1, 55, 56, 63, 64, 65, 127, 128, 129, 4097, 1 << 20] {
+            for zeros in [false, true] {
+                let bytes: Vec<_> = (0..size)
+                    .map(|i| if zeros { 0 } else { (i * 17 + i / 256) as u8 })
+                    .collect();
+                let expected: [u8; 32] = sha2::Sha256::digest(&bytes).into();
+                for chunk in [1, 63, 64, 65, 4096, 1 << 20] {
+                    let mut h = Sha256::new();
+                    for part in bytes.chunks(chunk) {
+                        h.update(part);
+                    }
+                    assert_eq!(h.finalize(), expected);
+                }
+            }
+        }
+    }
+}
