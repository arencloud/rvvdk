[
  {
    "name": "clippy",
    "command": [
      "cargo",
      "clippy",
      "--workspace",
      "--all-targets",
      "--",
      "-D",
      "warnings"
    ],
    "exit_code": 0
  },
  {
    "name": "tests",
    "command": [
      "cargo",
      "test",
      "--workspace"
    ],
    "exit_code": 0
  },
  {
    "name": "fmt",
    "command": [
      "cargo",
      "fmt",
      "--all",
      "--check"
    ],
    "exit_code": 0
  },
  {
    "name": "portable",
    "command": [
      "cargo",
      "check",
      "-p",
      "rvvdk-core",
      "-p",
      "rvvdk-datamover",
      "--lib",
      "--target",
      "wasm32-unknown-unknown"
    ],
    "exit_code": 101
  }
]
