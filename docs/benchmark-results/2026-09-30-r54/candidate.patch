+            }
+        },
+    };
+    assert_eq!(
+        rvvdk_cli::run(
+            f.args("copy", &["--progress", "--overwrite"]),
+            &mut Vec::new(),
+            &mut events
+        ),
+        1
+    );
+    assert_eq!(fs::read(&f.destination).unwrap(), b"winner");
