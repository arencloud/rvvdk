+        let path = f.root.join(name);
+        let mut error = Value::Null;
+        let mut events = Events {
+            buffer: vec![],
+            hook: |v: &Value| {
+                if v["phase"] == "verification" {
+                    let file = fs::OpenOptions::new().write(true).open(&path).unwrap();
+                    file.write_all_at(b"#", 0).unwrap();
+                }
+                if !v["error"].is_null() {
