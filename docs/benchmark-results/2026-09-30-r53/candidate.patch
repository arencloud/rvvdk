+        panic!("alias read")
+    }
+    fn write_at(&self, _: u64, _: &[u8]) -> rvvdk_core::Result<usize> {
+        panic!("alias write")
+    }
+    fn flush(&self) -> rvvdk_core::Result<()> {
+        panic!("alias flush")
+    }
